Options -Indexes
RewriteEngine On

# --- Hardening: version header + HTTPS + config protection --------------
# Strip the version header (belt-and-braces in case expose_php is on) and add
# a safe global MIME-sniffing guard. NOTE: deliberately NO X-Frame-Options /
# HSTS here — those would degrade cloned-landing fidelity (framing) and are a
# hard-to-undo commitment on a phishing host.
<IfModule mod_headers.c>
  Header always unset X-Powered-By
  Header always set X-Content-Type-Options "nosniff"
</IfModule>

# Block direct HTTP access to non-served file types. .json is intentionally
# NOT blocked — cloned landings ship manifest.json and other JSON assets.
<FilesMatch "\.(ini|sh|sql|gitignore|lock|md|dist)$">
  Require all denied
</FilesMatch>

# Block backup / editor files from the web (deploy .bak-YYYYMMDD, *.orig, *.save,
# *.old, *.swp). Without this a *.php.bak is served as PLAINTEXT = PHP source
# disclosure. (config/ — incl. db.php creds — is already fully blocked above.)
<FilesMatch "\.(bak|orig|save|old|swp)([.-].*)?$">
  Require all denied
</FilesMatch>

# Compress static text assets only — never text/html (it would add cache/
# transfer handling to the dynamic, session-bearing PHP responses).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Force HTTPS — MUST come before the routing rewrites (their [L] would stop
# processing first). The X-Forwarded-Proto exception prevents a redirect loop
# when TLS is terminated at a fronting proxy (e.g. Hostpoint) that forwards
# plain HTTP internally with X-Forwarded-Proto: https.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Never serve the config dir over HTTP (db.php + secret.key) -> 403.
# These files are still read server-side via PHP include; only HTTP access
# is blocked.
RewriteRule ^spear/config/ - [F,L]

# Defence in depth: never expose a VCS dir over HTTP (source disclosure),
# even if one ends up on the host. Matches .git as a full path segment so
# it doesn't catch .github pages etc.
RewriteRule (^|/)\.git(/|$) - [F,L]
# ------------------------------------------------------------------------

# Phase 3.55: TAPhish-hosted look-alike vanity paths.
# /p/<slug>/ serves the cloned landing page at spear/sniperhost/cloned/<slug>/
# (slug = lower alnum/hyphen, max 41). Must precede the generic clean-URL rule.
# 2026-06-08: the original single-rule version matched ONLY the bare slug —
# any sub-path (e.g. /p/<slug>/assets/style.css) fell through to the generic
# `^([^\.]+)$ $1.php` rule below, which 404'd because there was no such .php.
# Result: a cloned landing's <link href="assets/style.css"> never resolved,
# and the operator saw an unstyled white page. The bare-slug match stays
# first (preserves /p/foo and /p/foo/ shape); the sub-path rule below catches
# everything under the slug — .css, .js, images, manifests, anything.
RewriteRule ^p/([a-z0-9][a-z0-9-]{0,40})/?$ spear/sniperhost/cloned/$1/ [NC,L]
RewriteRule ^p/([a-z0-9][a-z0-9-]{0,40})/(.+)$ spear/sniperhost/cloned/$1/$2 [NC,L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([^\.]+)$ $1.php [NC,L]
