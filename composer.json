{
    "name": "tagmbh/taphish",
    "description": "TAPhish — t-alpha GmbH fork of SniperPhish, a phishing simulation toolkit for authorized security testing.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.9"
    },
    "autoload-dev": {
        "psr-4": {
            "TAPhish\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "find . -name '*.php' -not -path './spear/libs/*' -not -path './vendor/*' -print0 | xargs -0 -n1 -P4 php -l",
        "test": "phpunit",
        "phpcs": "phpcs"
    },
    "config": {
        "sort-packages": true
    }
}
